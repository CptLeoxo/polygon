# /etc/rc.conf (excerpt) - secondary (client-side) firewall. Example values.
hostname="fw-client"
clear_tmp_enable="YES"
syslogd_flags="-ss"
ntpd_enable="YES"
ntpd_sync_on_start="YES"
dumpdev="AUTO"
zfs_enable="YES"
sshd_enable="YES"

ifconfig_igb0="DHCP"
ifconfig_igb2="inet 192.168.33.5/24"
ifconfig_igb3="up"

gateway_enable="YES"

pf_enable="YES"
pf_rules="/etc/pf.conf"
pflog_enable="YES"
pflog_logfile="/var/log/pflog"

wireguard_enable="YES"
wireguard_interfaces="wg0"
