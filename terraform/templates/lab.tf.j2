# ============================================================================
# Lab "{{ lab.name }}" (lab_id {{ lab.lab_id }}) - {{ students | length }} student(s)
# GENERATED by scripts/render_lab.py - do not edit, edit labs/*.yaml instead.
# ============================================================================
{% for st in students %}

# ---------------------------------------------------------------- student {{ st.id }}
# VLAN {{ st.vlan }}, gateway 10.{{ st.id }}.0.1/16, node {{ st.node }}

resource "null_resource" "fw_vlan_s{{ st.id }}" {
  count = var.manage_fw_vlan ? 1 : 0

  # Destroy-time provisioners may only reference "self", so everything the
  # scripts need is stored in triggers. SSH authentication uses ssh-agent.
  triggers = {
    student_id = "{{ st.id }}"
    fw_host    = var.fw_host
    fw_user    = var.fw_user
    parent_if  = var.fw_parent_if
  }

  connection {
    type  = "ssh"
    host  = self.triggers.fw_host
    user  = self.triggers.fw_user
    agent = true
  }

  provisioner "remote-exec" {
    inline = ["sudo /usr/local/sbin/create_vlan.sh ${self.triggers.student_id} ${self.triggers.parent_if}"]
  }

  provisioner "remote-exec" {
    when   = destroy
    inline = ["sudo /usr/local/sbin/destroy_vlan.sh ${self.triggers.student_id} ${self.triggers.parent_if}"]
  }
}
{% for vm in lab.vms %}

# 10.{{ st.id }}.{{ lab.lab_id }}.{{ vm.id }}
resource "proxmox_vm_qemu" "{{ lab.name }}_s{{ st.id }}_{{ vm.name }}" {
  name        = "{{ lab.name }}-s{{ st.id }}-{{ vm.name }}"
  target_node = "{{ st.node }}"
  clone       = "{{ vm.template }}"
  full_clone  = {{ vm.full_clone | lower }}
  vmid        = {{ lab.lab_id * 100000 + st.id * 100 + vm.id }}

  cores   = {{ vm.cores }}
  sockets = {{ vm.sockets }}
  memory  = {{ vm.memory }}
  qemu_os = "{{ vm.qemu_os }}"
{% if vm.cloudinit %}

  os_type   = "cloud-init"
  ipconfig0 = "ip=10.{{ st.id }}.{{ lab.lab_id }}.{{ vm.id }}/16,gw=10.{{ st.id }}.0.1"
{% endif %}

  disks {
    {{ vm.disk.type }} {
      {{ vm.disk.type }}0 {
        disk {
          size    = "{{ vm.disk.size }}G"
          storage = "{{ vm.disk.storage }}"
        }
      }
    }
  }

  network {
    model  = "{{ vm.nic_model }}"
    bridge = "{{ vm.bridge }}"
    tag    = {{ st.vlan }}
  }

  depends_on = [null_resource.fw_vlan_s{{ st.id }}]
}
{% endfor %}
{% endfor %}
